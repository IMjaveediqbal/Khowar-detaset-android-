rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPrivilegedReader() {
      return signedIn()
        && request.auth.token.role in [
          'VALIDATOR', 'EXPERT', 'RESEARCHER', 'MODERATOR',
          'DATA_STEWARD', 'ADMIN', 'SUPER_ADMIN'
        ];
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /speech/{userId}/{fileName} {
      // Speech recordings are private to their contributor and trusted
      // review/research roles. Clients cannot write into another user's path.
      allow read: if owns(userId) || isPrivilegedReader();
      allow create, update: if owns(userId)
                            && request.resource.size < 100 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');
      allow delete: if owns(userId);
    }

    match /images/{userId}/{fileName} {
      allow read: if owns(userId) || isPrivilegedReader();
      allow create, update: if owns(userId)
                            && request.resource.size < 15 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if owns(userId);
    }

    // Explicit deny-by-default for every unrecognized path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
