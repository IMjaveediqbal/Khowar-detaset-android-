{
  "name": "khowar-dataset-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "npm run build && node --test test-policy.cjs",
    "test:integration": "npm run build && firebase emulators:exec --project demo-khowar --config ../firebase.json --only auth,firestore \"node --test test-integration.cjs\""
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.0",
    "typescript": "^5.8.3"
  }
}
