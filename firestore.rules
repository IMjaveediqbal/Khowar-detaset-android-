rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : ''; }
    function admin() { return role() in ['ADMIN','SUPER_ADMIN']; }
    function moderator() { return role() in ['MODERATOR','ADMIN','SUPER_ADMIN']; }
    function reviewer() { return role() in ['VALIDATOR','EXPERT','DATA_STEWARD','ADMIN','SUPER_ADMIN']; }
    match /{collection}/{id} {
      allow read: if collection in ['lexicon','sentences','speech','stories','knowledge','images'] && (resource.data.status == 'APPROVED' || (signedIn() && (resource.data.ownerUid == request.auth.uid || reviewer())));
      allow write: if false;
    }
    match /users/{id} {
      allow read: if signedIn() && (id == request.auth.uid || admin());
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if role() in ['AUDITOR','EXPERT','DATA_STEWARD','ADMIN','SUPER_ADMIN'];
      allow write: if false;
    }
    match /dataset_versions/{id} { allow read: if role() in ['EXPERT','RESEARCHER','DATA_STEWARD','ADMIN','SUPER_ADMIN']; allow write: if false; }
    match /consents/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || admin());
      allow write: if false;
    }
    match /validation_reviews/{id} {
      allow read: if reviewer() || role() == 'AUDITOR';
      allow write: if false;
    }
    match /moderationReports/{id} {
      allow read: if moderator() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow write: if false;
    }
    match /communityPosts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','authorProfileId','authorName','title','body','category','solved','linkedRecordType','linkedRecordId','answerCount','voteScore','createdAt','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authorProfileId == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.title is string && request.resource.data.title.size() >= 5 && request.resource.data.title.size() <= 160
        && request.resource.data.body is string && request.resource.data.body.size() >= 10 && request.resource.data.body.size() <= 5000
        && request.resource.data.category is string && request.resource.data.category.size() <= 100
        && request.resource.data.solved == false && request.resource.data.answerCount == 0 && request.resource.data.voteScore == 0;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solved','updatedAt'])
        && request.resource.data.solved is bool;
      allow delete: if false;
      match /comments/{commentId} {
        allow read: if true;
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
          && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 3000;
        allow create, delete: if false;
      }
      match /votes/{uid} { allow read: if signedIn() && uid == request.auth.uid; allow write: if false; }
      match /reports/{reportId} {
        allow read: if moderator();
        allow create: if signedIn() && request.resource.data.keys().hasOnly(['ownerUid','reporterProfileId','reason','createdAt'])
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.reporterProfileId == request.auth.uid
          && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
