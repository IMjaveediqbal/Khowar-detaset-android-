rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(data) { return signedIn() && data.ownerUid == request.auth.uid; }

    // Public dataset records: readable only after trusted validation.
    match /{collection}/{recordId} {
      allow read: if resource.data.status == 'APPROVED';
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'SUBMITTED'
                    && request.resource.data.contributorId is string
                    && request.resource.data.contributorId.size() > 0;
      allow update, delete: if false;
    }

    // Community: public reading, profile/authentication required for participation.
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.authorProfileId is string
                    && request.resource.data.authorName is string
                    && request.resource.data.title is string
                    && request.resource.data.body is string
                    && request.resource.data.category is string
                    && request.resource.data.solved == false
                    && request.resource.data.answerCount == 0
                    && request.resource.data.voteScore == 0;
      // Authors may resolve their own thread, but counters/content are backend-controlled.
      allow update: if own(resource.data)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.authorProfileId == resource.data.authorProfileId
                    && request.resource.data.authorName == resource.data.authorName
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solved', 'updatedAt']);
      allow delete: if own(resource.data);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.authorProfileId is string
                      && request.resource.data.authorName is string
                      && request.resource.data.body is string
                      && request.resource.data.accepted == false;
        allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      // Voting is performed only by the trusted Cloud Function.
      match /votes/{userId} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if false;
        allow create: if signedIn()
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.reporterProfileId is string
                      && request.resource.data.reason is string;
        allow update, delete: if false;
      }
    }
  }
}
