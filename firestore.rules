rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{recordId} {
      // Only validated records are publicly readable.
      allow read: if resource.data.status == 'APPROVED';

      // A client can create only its own SUBMITTED record.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'SUBMITTED'
                    && request.resource.data.contributorId is string
                    && request.resource.data.contributorId.size() > 0;

      // Clients cannot alter or delete submissions after upload.
      // Promotion to APPROVED belongs to a trusted backend/admin workflow.
      allow update, delete: if false;
    }
  }
}
